---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// RoastConsole spans the whole roastery — shown as one connected "signal" (bean to cup).
const pipeline = [
  { n: "01", name: "Green Coffee", desc: "Lot tracking, purchase orders, and AI reorder forecasts." },
  { n: "02", name: "Roasting", desc: "AI scheduling, Profile Studio, and self-calculating run logs." },
  { n: "03", name: "Quality", desc: "SCA cupping, physical analysis, full traceability." },
  { n: "04", name: "Sales & CRM", desc: "Wholesale orders, AI lead scoring, customer portal." },
  { n: "05", name: "Fulfillment", desc: "Smart packing, delivery routing, proof of delivery." },
  { n: "06", name: "Financials", desc: "Invoicing, Stripe, true per-bag margin." },
];

const pillars = [
  {
    title: "One platform, bean to cup",
    body: "Green inventory, roasting, quality, sales, fulfillment, and finance in a single system — each module feeding the next. Enter data once, trust it everywhere.",
  },
  {
    title: "Intelligence where it counts",
    body: "AI tells you what to roast, when to reorder, and which leads to call — so your team spends its time on coffee, not coordination.",
  },
  {
    title: "Built for specialty",
    body: "SCA-standard cupping, complete bean-to-cup traceability, and true per-bag margins come standard. The details are the difference.",
  },
];

const stats = [
  { value: "40%", label: "Production efficiency", note: "AI-optimized batch scheduling" },
  { value: "99%", label: "Inventory accuracy", note: "Real-time across all warehouses" },
  { value: "35%", label: "Quality consistency", note: "Standardized cupping workflows" },
  { value: "60%", label: "Time saved", note: "Automated fulfillment & invoicing" },
];

const customers = ["monosen", "Blust", "Overcut", "Reverse", "Scale", "Primex"];

const principles = [
  {
    num: "01",
    title: "Go deep, not wide",
    body: "We embed in a single industry until our product is the obvious standard — not a nice-to-have, but the system the work runs on.",
  },
  {
    num: "02",
    title: "Opinionated software",
    body: "Built around how the craft is actually practiced. Sharp defaults, no bloat, and AI only where it genuinely earns its place.",
  },
  {
    num: "03",
    title: "A repeatable playbook",
    body: "What we prove with RoastConsole becomes the blueprint. Each industry we rebuild makes the next one faster.",
  },
];
---
<Base>
  <Nav />

  <main id="top">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="grid-bg"></div>
      <div class="wrap">
        <div class="inner">
          <span class="eyebrow"><span class="pulse"></span>Independent product studio</span>
          <h1>Build once.<br /><span class="accent">Speak far.</span></h1>
          <p class="lede">
            Farspeak Labs builds the operating systems for industries that still run on
            spreadsheets and gut feel. We go deep in one craft until our product is the standard —
            then carry the playbook to the next. <b>We're starting with coffee.</b>
          </p>
          <div class="cta">
            <a href="#roastconsole" class="btn solid lg">Meet RoastConsole <span class="arrow">→</span></a>
            <a href="#approach" class="btn lg">How we work</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FLAGSHIP: ROASTCONSOLE ============ -->
    <section class="block flagship" id="roastconsole">
      <div class="wrap">
        <div class="flag-head">
          <div>
            <span class="eyebrow lime"><span class="pulse"></span>Flagship · Live</span>
            <h2 class="flag-title">RoastConsole</h2>
            <p class="flag-tagline">
              The complete operating system for specialty coffee roasters. From the green coffee on
              your dock to the cup in your customer's hand — one platform. No spreadsheets, no
              disconnected tools, no guesswork.
            </p>
            <div class="cta">
              <a href="https://roastconsole.com" target="_blank" rel="noopener" class="btn solid lime-btn lg">
                Visit RoastConsole <span class="arrow">↗</span>
              </a>
              <a href="https://roastconsole.com" target="_blank" rel="noopener" class="btn lg">Request a demo</a>
            </div>
          </div>

          <!-- roast curve visual -->
          <figure class="chart" aria-label="Example roast curve">
            <div class="chart-top mono">
              <span><i class="dot"></i> Live Roast · Ethiopia Yirgacheffe</span>
              <span class="temp">204.6°C</span>
            </div>
            <svg viewBox="0 0 600 240" preserveAspectRatio="none" role="img">
              <defs>
                <linearGradient id="fill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="var(--roast-lime)" stop-opacity=".22" />
                  <stop offset="100%" stop-color="var(--roast-lime)" stop-opacity="0" />
                </linearGradient>
              </defs>
              <g stroke="var(--line-2)" stroke-width="1">
                <line x1="0" y1="48"  x2="600" y2="48"  />
                <line x1="0" y1="96"  x2="600" y2="96"  />
                <line x1="0" y1="144" x2="600" y2="144" />
                <line x1="0" y1="192" x2="600" y2="192" />
              </g>
              <g stroke="var(--line-2)" stroke-dasharray="3 5" stroke-width="1">
                <line x1="200" y1="0" x2="200" y2="240" />
                <line x1="400" y1="0" x2="400" y2="240" />
              </g>
              <path d="M10,162 C40,188 72,190 102,180 S210,120 300,92 S470,60 590,50 L590,240 L10,240 Z" fill="url(#fill)" />
              <path d="M10,162 C40,188 72,190 102,180 S210,120 300,92 S470,60 590,50"
                    fill="none" stroke="var(--roast-lime)" stroke-width="2.5" stroke-linecap="round" />
              <path d="M10,120 C60,118 120,110 220,96 S420,70 590,60"
                    fill="none" stroke="var(--signal)" stroke-width="1.6" stroke-opacity=".55" stroke-dasharray="1 5" stroke-linecap="round" />
              <circle cx="590" cy="50" r="4" fill="var(--roast-lime)" />
            </svg>
            <div class="chart-legend mono">
              <span><i class="ph"></i>Drying</span>
              <span><i class="ph"></i>Maillard</span>
              <span><i class="ph"></i>Development</span>
            </div>
          </figure>
        </div>

        <!-- bean-to-cup pipeline (the "signal" through the whole roastery) -->
        <div class="pipe-label mono">One connected signal · bean&nbsp;→&nbsp;cup</div>
        <div class="pipeline">
          {pipeline.map((s) => (
            <div class="stage">
              <span class="node"></span>
              <div class="stage-name mono">{s.n} · {s.name}</div>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>

        <!-- why roasters choose -->
        <div class="pillars">
          {pillars.map((p) => (
            <article class="pillar">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))}
        </div>

        <!-- stats -->
        <div class="stats">
          {stats.map((s) => (
            <div class="stat">
              <div class="val">{s.value}</div>
              <div class="lbl">{s.label}</div>
              <div class="nte mono">{s.note}</div>
            </div>
          ))}
        </div>

        <!-- customers -->
        <div class="trusted">
          <span class="mono trusted-label">Trusted by specialty roasters worldwide</span>
          <div class="logos">
            {customers.map((c) => <span class="logo">{c}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ APPROACH ============ -->
    <section class="block" id="approach">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <span class="eyebrow" style="margin-bottom:14px"><span class="pulse"></span>How we work</span>
            <h2>A small lab with<br />a long signal.</h2>
          </div>
          <p>We stay deliberately small and let the products carry the distance.</p>
        </div>

        <div class="principles">
          {principles.map((p) => (
            <div class="pr">
              <div class="num mono">{p.num}</div>
              <h4>{p.title}</h4>
              <p>{p.body}</p>
            </div>
          ))}
        </div>

        <div class="divider" style="margin-top:64px"><span class="n"></span><span class="l"></span><span class="f"></span></div>
      </div>
    </section>

    <!-- ============ CONTACT ============ -->
    <section class="contact" id="contact">
      <div class="wrap">
        <span class="eyebrow" style="margin-bottom:22px"><span class="pulse"></span>Open channel</span>
        <h2>Let's speak.</h2>
        <p>Partnerships, press, or an industry you think we should rebuild next — the line is open.</p>
        <a class="mail mono" href="mailto:hello@farspeak.com">hello@farspeak.com</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; padding: 124px 0 100px; overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(60% 50% at 16% 0%, rgba(76,194,255,.10), transparent 70%),
      radial-gradient(50% 50% at 92% 18%, rgba(124,108,255,.07), transparent 70%);
  }
  .grid-bg {
    position: absolute; inset: 0; z-index: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 46px 46px; opacity: .35;
    -webkit-mask-image: radial-gradient(circle at 28% 25%, #000, transparent 70%);
    mask-image: radial-gradient(circle at 28% 25%, #000, transparent 70%);
  }
  .hero .inner { position: relative; z-index: 1; max-width: 760px; }
  h1 {
    font-family: var(--font-display); font-weight: 600; letter-spacing: -.025em; line-height: 1.02;
    font-size: clamp(42px, 7vw, 76px); margin: 26px 0 22px;
  }
  h1 .accent { color: var(--signal); }
  .lede { font-size: clamp(17px, 2.2vw, 21px); color: var(--muted); max-width: 600px; }
  .lede b { color: var(--ink); font-weight: 500; }
  .cta { display: flex; gap: 14px; margin-top: 38px; flex-wrap: wrap; }

  /* ---------- flagship ---------- */
  .eyebrow.lime { color: var(--roast-lime); }
  .eyebrow.lime .pulse { background: var(--roast-lime); box-shadow: 0 0 10px var(--roast-lime); }
  .flag-head { display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: center; }
  @media (max-width: 860px) { .flag-head { grid-template-columns: 1fr; gap: 40px; } }
  .flag-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(34px, 5vw, 52px); letter-spacing: -.025em; margin: 16px 0 16px; }
  .flag-tagline { color: var(--muted); font-size: 16px; max-width: 480px; margin-bottom: 30px; }
  .btn.lime-btn { background: var(--roast-lime); color: #18210a; border-color: var(--roast-lime); }
  .btn.lime-btn:hover { background: #ddff7a; }

  /* roast chart */
  .chart { background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px 14px; }
  .chart-top { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--muted); margin-bottom: 12px; }
  .chart-top .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--roast-lime); box-shadow: 0 0 8px var(--roast-lime); margin-right: 7px; vertical-align: middle; }
  .chart-top .temp { color: var(--roast-lime); font-weight: 500; }
  .chart svg { width: 100%; height: 200px; display: block; }
  .chart-legend { display: flex; gap: 20px; margin-top: 12px; font-size: 11px; color: var(--dim); }
  .chart-legend .ph { display: inline-block; width: 8px; height: 8px; border-radius: 2px; background: var(--roast-lime); opacity: .5; margin-right: 6px; }
  .chart-legend span:nth-child(2) .ph { opacity: .75; }
  .chart-legend span:nth-child(3) .ph { opacity: 1; }

  /* bean-to-cup pipeline */
  .pipe-label { margin-top: 70px; margin-bottom: 26px; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--dim); text-align: center; }
  .pipeline { display: grid; grid-template-columns: repeat(6, 1fr); gap: 22px; position: relative; }
  .pipeline::before {
    content: ""; position: absolute; top: 5px; left: 6%; right: 6%; height: 0;
    border-top: 2px dashed var(--line-2); z-index: 0;
  }
  .stage { position: relative; z-index: 1; padding-top: 24px; }
  .stage .node {
    position: absolute; top: 0; left: 0; width: 11px; height: 11px; border-radius: 50%;
    background: var(--roast-lime); box-shadow: 0 0 0 4px var(--bg), 0 0 10px rgba(208,242,85,.5);
  }
  .stage:first-child .node { background: var(--ink); box-shadow: 0 0 0 4px var(--bg); }
  .stage-name { font-size: 12px; color: var(--ink); letter-spacing: .02em; }
  .stage p { color: var(--muted); font-size: 13px; margin-top: 6px; line-height: 1.5; }
  @media (max-width: 860px) {
    .pipeline { grid-template-columns: 1fr 1fr; gap: 28px 22px; }
    .pipeline::before { display: none; }
  }
  @media (max-width: 460px) { .pipeline { grid-template-columns: 1fr; } }

  /* why pillars */
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 70px; }
  @media (max-width: 760px) { .pillars { grid-template-columns: 1fr; } }
  .pillar { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; transition: border-color .2s, transform .2s; }
  .pillar:hover { border-color: var(--line-2); transform: translateY(-3px); }
  .pillar h3 { font-family: var(--font-display); font-weight: 600; font-size: 19px; letter-spacing: -.01em; }
  .pillar h3::before { content: "◆"; color: var(--roast-lime); font-size: 12px; margin-right: 9px; vertical-align: middle; }
  .pillar p { color: var(--muted); font-size: 14.5px; margin-top: 12px; }

  /* stats */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 56px; padding: 36px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  @media (max-width: 760px) { .stats { grid-template-columns: repeat(2, 1fr); gap: 32px 20px; } }
  .stat .val { font-family: var(--font-display); font-weight: 600; font-size: clamp(32px, 5vw, 46px); letter-spacing: -.02em; color: var(--roast-lime); line-height: 1; }
  .stat .lbl { font-size: 14px; margin-top: 10px; font-weight: 500; }
  .stat .nte { font-size: 11px; color: var(--dim); margin-top: 4px; }

  /* customers */
  .trusted { margin-top: 48px; text-align: center; }
  .trusted-label { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--dim); }
  .logos { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 44px; margin-top: 22px; }
  .logo { font-family: var(--font-display); font-weight: 500; font-size: 19px; color: var(--muted); opacity: .65; transition: opacity .2s, color .2s; }
  .logo:hover { opacity: 1; color: var(--ink); }

  /* ---------- approach ---------- */
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  @media (max-width: 760px) { .principles { grid-template-columns: 1fr; } }
  .pr { padding-top: 22px; border-top: 1px solid var(--line-2); }
  .pr .num { font-size: 12px; color: var(--signal); letter-spacing: .1em; }
  .pr h4 { font-family: var(--font-display); font-weight: 600; font-size: 19px; margin: 14px 0 8px; letter-spacing: -.01em; }
  .pr p { color: var(--muted); font-size: 14.5px; }

  /* ---------- contact ---------- */
  .contact { text-align: center; padding: 112px 0; border-top: 1px solid var(--line); }
  .contact h2 { font-family: var(--font-display); font-weight: 600; font-size: clamp(30px, 5vw, 52px); letter-spacing: -.025em; line-height: 1.05; margin-bottom: 18px; }
  .contact p { color: var(--muted); max-width: 470px; margin: 0 auto 32px; font-size: 16px; }
  .mail { font-size: clamp(16px, 3vw, 22px); color: var(--signal); border-bottom: 1px solid rgba(76,194,255,.3); padding-bottom: 3px; transition: border-color .2s; }
  .mail:hover { border-color: var(--signal); }
</style>
