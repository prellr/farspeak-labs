---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// Real app icons shipped by the studio (used in the hero shelf).
const shelf = [
  { src: "/products/photoescape-icon.png", alt: "PhotoEscape app icon" },
  { src: "/products/shutterkit-recover.png", alt: "Shutterkit Recover icon" },
  { src: "/products/shutterkit-offload.png", alt: "Shutterkit Offload icon" },
  { src: "/products/shutterkit-check.png", alt: "Shutterkit Check icon" },
  { src: "/products/shutterkit-repair.png", alt: "Shutterkit Repair icon" },
  { src: "/products/shutterkit-cull.png", alt: "Shutterkit Cull icon" },
];

const shutterkitApps = [
  { src: "/products/shutterkit-recover.png", name: "Recover", note: "Get deleted files back" },
  { src: "/products/shutterkit-check.png", name: "Check", note: "Catch fake cards" },
  { src: "/products/shutterkit-repair.png", name: "Repair", note: "Fix clips that won't play" },
  { src: "/products/shutterkit-offload.png", name: "Offload", note: "Copy, verified" },
  { src: "/products/shutterkit-cull.png", name: "Cull", note: "Pick a shoot fast" },
];

const beliefs = [
  { lead: "One job, done well.", body: "Each app has a clear purpose and no bloat. If a feature does not earn its place, it does not ship." },
  { lead: "Private by default.", body: "No accounts, no cloud upload, no analytics. Your files are read and written on your own machine." },
  { lead: "Buy it, own it.", body: "One-time prices and real updates, for the apps. Bespoke work you own outright. No subscription treadmill." },
  { lead: "Honest about limits.", body: "We say what the software cannot do in the same breath as what it can. That is what earns trust." },
];
---
<Base>
  <Nav />

  <main id="top">
    <!-- ========================= HERO ========================= -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1>Build once.<br />Speak far.</h1>
          <p>
            An independent software studio. We make honest, private apps you own,
            and build custom software for companies tired of subscriptions.
          </p>
          <div class="cta">
            <a href="#products" class="btn primary">See the work
              <svg class="ico" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="#contact" class="btn">Build with us</a>
          </div>
        </div>

        <!-- real shipped app icons: proof, not decoration -->
        <div class="shelf" aria-label="A selection of apps made by Farspeak Labs">
          {shelf.map((i) => (
            <div class="tile"><img src={i.src} alt={i.alt} width="80" height="80" loading="eager" /></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================= PRODUCTS ========================= -->
    <section id="products" class="products">
      <div class="wrap">
        <header class="sec-intro reveal">
          <span class="kicker">Things we have shipped</span>
          <h2>Software with a point of view.</h2>
          <p class="lede">Four products so far. Each does one job well, respects your privacy, and never asks for a monthly fee it did not earn.</p>
        </header>

        <!-- RoastConsole: flagship feature row -->
        <article class="flagship reveal">
          <div class="flag-copy">
            <div class="pname">RoastConsole <span class="status live">Live</span></div>
            <h3>The operating system for specialty coffee roasters.</h3>
            <p>From the green coffee on the dock to the cup in a customer's hand, one platform runs the whole roastery: inventory, roasting, quality, sales, fulfillment and finance. It replaces a drawer full of spreadsheets.</p>
            <a class="link" href="https://roastconsole.com" target="_blank" rel="noopener">roastconsole.com
              <svg class="ico" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11l6-6M6.5 5H11v4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <figure class="roast" aria-label="A roast curve, bean temperature over time">
            <svg viewBox="0 0 560 300" role="img" preserveAspectRatio="none">
              <g stroke="var(--line)" stroke-width="1">
                <line x1="0" y1="75" x2="560" y2="75" /><line x1="0" y1="150" x2="560" y2="150" /><line x1="0" y1="225" x2="560" y2="225" />
              </g>
              <path d="M12,200 C44,236 80,238 112,224 S232,150 320,116 S470,74 548,62" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" />
              <circle cx="548" cy="62" r="4.5" fill="var(--accent)" />
            </svg>
            <figcaption class="mono">A roast, start to finish</figcaption>
          </figure>
        </article>

        <!-- Shutterkit: a suite, shown as its real app family -->
        <article class="suite reveal">
          <div class="suite-head">
            <div>
              <div class="pname">Shutterkit</div>
              <h3>Five Mac apps for memory cards and shoots.</h3>
              <p>Recover deleted photos, catch fake cards, fix clips that won't play, copy cards with checksums you can trust, and cull a shoot fast. Buy one app, or the suite.</p>
              <a class="link" href="https://shutterkit.app" target="_blank" rel="noopener">shutterkit.app
                <svg class="ico" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11l6-6M6.5 5H11v4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          <ul class="apps">
            {shutterkitApps.map((a) => (
              <li>
                <img src={a.src} alt={`Shutterkit ${a.name} icon`} width="60" height="60" loading="lazy" />
                <span class="an">{a.name}</span>
                <span class="anote">{a.note}</span>
              </li>
            ))}
          </ul>
        </article>

        <!-- PhotoEscape: real screenshot split -->
        <article class="split reveal">
          <div class="split-copy">
            <div class="pname">
              <img class="pm" src="/products/photoescape-icon.png" alt="PhotoEscape icon" width="34" height="34" />
              PhotoEscape
            </div>
            <h3>Get your photos out of Google and Snapchat, whole.</h3>
            <p>Exports from Google Takeout and Snapchat strip the dates, places and captions out of your photos. PhotoEscape puts them back, fixes the time zones, and adds everything to Apple Photos. Nothing leaves your Mac.</p>
            <div class="row">
              <span class="price mono">$19 once</span>
              <a class="link" href="https://photoescape.app" target="_blank" rel="noopener">photoescape.app
                <svg class="ico" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11l6-6M6.5 5H11v4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          <figure class="shot">
            <img src="/products/photoescape-screen.png" alt="PhotoEscape repairing a Google Takeout export on macOS" width="900" height="612" loading="lazy" />
          </figure>
        </article>

        <!-- MailEscape: in development, quieter treatment -->
        <article id="mailescape" class="soon reveal">
          <div class="soon-left">
            <div class="pname">MailEscape <span class="status dev">In development</span></div>
            <h3>Open and move your Outlook mail, without Outlook.</h3>
          </div>
          <p>Legacy Outlook for Mac stopped working in October 2026. MailEscape reads your old <span class="mono">.olm</span> and <span class="mono">.pst</span> archives, lets you search them, and moves the mail into Apple Mail. No sign-in, nothing deleted, everything stays on your Mac.</p>
        </article>
      </div>
    </section>

    <!-- ========================= BESPOKE ========================= -->
    <section id="bespoke" class="bespoke">
      <div class="wrap bespoke-grid reveal">
        <div class="bespoke-copy">
          <h2>Software built for you.<br />Owned by you.</h2>
          <p>Most business software is rented by the seat, forever. We build custom tools your company owns outright, shaped to the way you actually work. Pay once for the build, run it for years, and change it when the business changes.</p>
          <a href="#contact" class="btn primary">Build with us
            <svg class="ico" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <dl class="facts">
          <div><dt>You own the code</dt><dd>The software and its source are yours, not licensed back to you.</dd></div>
          <div><dt>No seat fees</dt><dd>Pay for the work once. Add as many people as you like.</dd></div>
          <div><dt>Fits your process</dt><dd>Built around how your team works, not the other way around.</dd></div>
        </dl>
      </div>
    </section>

    <!-- ========================= HOW WE WORK ========================= -->
    <section class="beliefs">
      <div class="wrap">
        <h2 class="reveal">How we work.</h2>
        <div class="belief-grid">
          {beliefs.map((b) => (
            <div class="belief reveal">
              <h4>{b.lead}</h4>
              <p>{b.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================= CONTACT ========================= -->
    <section id="contact" class="contact">
      <div class="wrap reveal">
        <h2>Let's build something you own.</h2>
        <p>Tell us about the software your company needs, or just say hello.</p>
        <a class="mail" href="mailto:team@farspeaklabs.com">team@farspeaklabs.com</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------------- hero ---------------- */
  .hero { padding: 72px 0 84px; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
  .hero-copy h1 { font-size: clamp(44px, 6.4vw, 78px); font-weight: 600; }
  .hero-copy p { margin-top: 22px; font-size: clamp(16px, 1.5vw, 19px); color: var(--muted); max-width: 30ch; }
  .cta { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }

  .shelf {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px 24px;
    justify-items: center;
  }
  .shelf .tile:nth-child(3n+2) { transform: translateY(18px); }
  .shelf img { filter: drop-shadow(0 14px 26px rgba(0,0,0,0.45)); transition: transform 0.25s var(--ease); }
  .shelf .tile:hover img { transform: translateY(-4px); }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: 48px; }
    .hero-copy p { max-width: 40ch; }
    .shelf { grid-template-columns: repeat(6, 1fr); gap: 16px; }
    .shelf .tile:nth-child(3n+2) { transform: none; }
    .shelf img { width: 64px; height: 64px; }
  }
  @media (max-width: 520px) { .shelf { grid-template-columns: repeat(3, 1fr); } }

  /* ---------------- products shared ---------------- */
  .products { padding: 40px 0 24px; }
  .sec-intro { max-width: 640px; margin-bottom: 64px; }
  .sec-intro .kicker { display: block; margin-bottom: 16px; }
  .sec-intro h2 { font-size: clamp(30px, 4vw, 44px); }
  .sec-intro .lede { margin-top: 16px; color: var(--muted); font-size: 17px; max-width: 54ch; }

  .pname {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--font-display); font-weight: 600; font-size: 15px;
    letter-spacing: 0.01em; color: var(--muted); margin-bottom: 18px;
  }
  .pname .pm { border-radius: 8px; }
  .status { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; padding: 3px 8px; border-radius: 20px; font-weight: 400; }
  .status.live { color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); }
  .status.dev { color: var(--dim); border: 1px solid var(--line-strong); }

  article h3 { font-size: clamp(24px, 3vw, 34px); font-weight: 600; max-width: 20ch; }
  article p { color: var(--muted); margin-top: 16px; font-size: 16px; max-width: 56ch; }
  article .link { margin-top: 22px; }

  /* RoastConsole flagship */
  .flagship {
    display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;
    padding: 48px 0; border-top: 1px solid var(--line);
  }
  .roast { border: 1px solid var(--line); border-radius: var(--r); background: var(--bg-2); padding: 18px; }
  .roast svg { width: 100%; height: 220px; }
  .roast figcaption { margin-top: 10px; font-size: 12px; color: var(--dim); }

  /* Shutterkit suite */
  .suite { padding: 56px 0; border-top: 1px solid var(--line); }
  .suite-head { max-width: 640px; }
  .apps {
    list-style: none; margin-top: 40px;
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px;
  }
  .apps li {
    display: flex; flex-direction: column; align-items: flex-start; gap: 8px;
    padding: 20px; border: 1px solid var(--line); border-radius: var(--r); background: var(--panel);
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .apps li:hover { border-color: var(--line-strong); transform: translateY(-3px); }
  .apps img { border-radius: 12px; }
  .apps .an { font-family: var(--font-display); font-weight: 600; font-size: 16px; margin-top: 4px; }
  .apps .anote { font-size: 12.5px; color: var(--dim); line-height: 1.4; }
  @media (max-width: 860px) { .apps { grid-template-columns: repeat(2, 1fr); } }

  /* PhotoEscape split */
  .split {
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: center;
    padding: 56px 0; border-top: 1px solid var(--line);
  }
  .split .row { display: flex; align-items: center; gap: 20px; margin-top: 22px; }
  .price { font-size: 14px; color: var(--ink); padding: 4px 10px; border: 1px solid var(--line-strong); border-radius: 20px; }
  .shot { border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; background: var(--bg-2); }
  .shot img { width: 100%; height: auto; display: block; }
  @media (max-width: 860px) { .flagship, .split { grid-template-columns: 1fr; gap: 32px; } .split .shot { order: -1; } }

  /* MailEscape soon */
  .soon {
    display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: end;
    padding: 56px 0; border-top: 1px solid var(--line);
  }
  .soon p { max-width: none; }
  @media (max-width: 860px) { .soon { grid-template-columns: 1fr; gap: 20px; } }

  /* ---------------- bespoke ---------------- */
  .bespoke { padding: 96px 0; margin-top: 40px; border-top: 1px solid var(--line); background: var(--bg-2); }
  .bespoke-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 64px; align-items: start; }
  .bespoke-copy h2 { font-size: clamp(30px, 4.4vw, 48px); }
  .bespoke-copy p { color: var(--muted); margin-top: 20px; font-size: 17px; max-width: 48ch; }
  .bespoke-copy .btn { margin-top: 30px; }
  .facts { display: flex; flex-direction: column; gap: 0; }
  .facts > div { padding: 22px 0; border-top: 1px solid var(--line); }
  .facts dt { font-family: var(--font-display); font-weight: 600; font-size: 18px; }
  .facts dd { color: var(--muted); font-size: 15px; margin-top: 6px; }
  @media (max-width: 860px) { .bespoke-grid { grid-template-columns: 1fr; gap: 36px; } }

  /* ---------------- beliefs ---------------- */
  .beliefs { padding: 96px 0; }
  .beliefs h2 { font-size: clamp(28px, 3.6vw, 40px); margin-bottom: 48px; }
  .belief-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 56px; }
  .belief { border-top: 1px solid var(--line-strong); padding-top: 20px; }
  .belief h4 { font-family: var(--font-display); font-weight: 600; font-size: 19px; }
  .belief p { color: var(--muted); font-size: 15.5px; margin-top: 10px; max-width: 46ch; }
  @media (max-width: 680px) { .belief-grid { grid-template-columns: 1fr; gap: 32px; } }

  /* ---------------- contact ---------------- */
  .contact { padding: 110px 0; border-top: 1px solid var(--line); text-align: center; }
  .contact h2 { font-size: clamp(30px, 5vw, 52px); }
  .contact p { color: var(--muted); font-size: 17px; margin: 18px auto 34px; max-width: 42ch; }
  .mail {
    font-family: var(--font-mono); font-size: clamp(16px, 3vw, 22px);
    color: var(--accent); border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    padding-bottom: 4px; transition: border-color 0.2s;
  }
  .mail:hover { border-bottom-color: var(--accent); }
</style>
