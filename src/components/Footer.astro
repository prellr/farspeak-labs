---
import Wordmark from "./Wordmark.astro";
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap">
    <div class="row">
      <Wordmark size={20} class="dim" />
      <div class="social">
        <a href="https://roastconsole.com" target="_blank" rel="noopener">RoastConsole ↗</a>
        <a href="#" aria-label="Farspeak Labs on X">X</a>
        <a href="#" aria-label="Farspeak Labs on LinkedIn">LinkedIn</a>
      </div>
      <span class="copy mono">© {year} Farspeak Labs · Build once. Speak far.</span>
    </div>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--line); padding: 36px 0; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .dim { opacity: .85; }
  .social { display: flex; gap: 22px; }
  .social a { font-size: 13px; color: var(--muted); transition: color .15s; }
  .social a:hover { color: var(--ink); }
  .copy { font-size: 11.5px; color: var(--dim); letter-spacing: .04em; }
</style>
