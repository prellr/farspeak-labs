---
import Wordmark from "./Wordmark.astro";
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="top">
      <Wordmark size={22} />
      <nav class="cols">
        <div>
          <span class="h mono">Products</span>
          <a href="https://roastconsole.com" target="_blank" rel="noopener">RoastConsole</a>
          <a href="https://shutterkit.app" target="_blank" rel="noopener">Shutterkit</a>
          <a href="https://photoescape.app" target="_blank" rel="noopener">PhotoEscape</a>
          <a href="#mailescape">MailEscape</a>
        </div>
        <div>
          <span class="h mono">Studio</span>
          <a href="#bespoke">Custom software</a>
          <a href="#contact">Contact</a>
          <a href="mailto:team@farspeaklabs.com">team@farspeaklabs.com</a>
        </div>
      </nav>
    </div>
    <div class="base">
      <span class="mono">© {year} Farspeak Labs LLC</span>
      <span class="mono">Wisconsin, USA</span>
    </div>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); padding: 56px 0 40px; margin-top: 40px; }
  .top { display: flex; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .cols { display: flex; gap: 64px; flex-wrap: wrap; }
  .cols div { display: flex; flex-direction: column; gap: 12px; }
  .cols .h { color: var(--dim); font-size: 12px; letter-spacing: 0.06em; margin-bottom: 4px; }
  .cols a { font-size: 14.5px; color: var(--muted); transition: color 0.15s; }
  .cols a:hover { color: var(--ink); }
  .base {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line);
    font-size: 12px; color: var(--dim); letter-spacing: 0.03em;
  }
  @media (max-width: 560px) { .cols { gap: 40px; } }
</style>
